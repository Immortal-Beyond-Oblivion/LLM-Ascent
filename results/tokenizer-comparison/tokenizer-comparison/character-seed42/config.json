{
  "act": "tokenizer-comparison",
  "experiment": "main",
  "seed": 42,
  "dataset_path": "data/tinyshakespeare.txt",
  "train_fraction": 0.9,
  "tokenizer": "character",
  "bpe_merges": 100,
  "context_length": 64,
  "embedding_dim": 64,
  "num_heads": 4,
  "num_layers": 2,
  "dropout": 0.0,
  "normalization": "layernorm",
  "optimized_attention": true,
  "steps": 500,
  "batch_size": 16,
  "learning_rate": 0.001,
  "warmup_steps": 0,
  "eval_interval": 100,
  "eval_batches": 10,
  "device": "auto",
  "output_root": "results/tokenizer-comparison"
}