.venv/
*.pyc
__pycache__/
.DS_Store

# Course lecture PDFs: 165 MB of slides, not project source. Fetch from the
# course share instead of versioning them.
docs/lectures/

# Checkpoints, optimizer state and raw run outputs. Every one of these is
# reproducible from `results/` + the run scripts, so they stay local.
artifacts/

# Source corpora for acts 4, 6, 8, 9 and 10: 1.1 GB of downloads. Fetch them
# with `python -m tools.fetch_data`; the script documents the upstream dataset
# for each file and verifies the record count and field schema on arrival.
# The processed token corpus (artifacts/scaling/corpus_tokens.mmap) is derived
# from the C4 shard by src/scaling/preprocess.py.
data/v2/

# Browser-automation scratch from local verification runs.
.playwright-mcp/

# Film: source is tracked, generated media is not (see video/ascent/scripts/).
video/ascent/node_modules/
video/ascent/.hyperframes/
video/ascent/out/
video/ascent/renders/
video/ascent/assets/report/
video/ascent/assets/audio/
video/ascent/assets/fig/
